{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "prettier.requireConfig": true,
  "prettier.configPath": "packages/configs/prettier.config.js",
  "eslint.options": {
    "overrideConfigFile": "packages/configs/eslint.config.mjs"
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.wordWrap": "on",
  "editor.cursorBlinking": "expand",
  "editor.mouseWheelZoom": false,

  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true,
    // "**/node_modules/**": true,
    "**/.git/**": true
    // "**/dist/**": true,
    // "**/build/**": true
  },
  "files.exclude": {
    // "**/node_modules": true,
    // "**/build": true,s
    // "**/dist": true,
    "**/.codegraph": true,
    "**/.agents": true
  },
  "search.followSymlinks": false,
  "js/ts.tsdk.path": "node_modules/.pnpm/typescript@6.0.3/node_modules/typescript/lib",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "references.preferredLocation": "view",
  "js/ts.autoClosingTags.enabled": true,
  "js/ts.suggest.paths": true,
  "css.validate": false,
  "scss.validate": false,
  "explorer.excludeGitIgnore": false,
  "nxConsole.nxWorkspacePath": ""
}
