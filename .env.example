# NX
NX_TUI=false

# Application
NODE_ENV=development
PORT=3000

# Database
DB_USER=signa
DB_PASSWORD=signa_dev_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=signa

# JWT / Security
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=1d
BALLOT_SECRET=your-ballot-hmac-secret-min-32-chars-change-in-production

# Redis (used by Queue and Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0

# Cache
# Options: "memory" or "redis"
# Use "memory" for development (no Redis required)
# Use "redis" for production (requires Redis running)
CACHE_TYPE=memory

# S3 / MinIO
# For local development: kubectl port-forward svc/minio 9000:9000
S3_BUCKET=signa-ballots
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
