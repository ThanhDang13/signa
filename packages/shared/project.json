{
  "name": "@signa/shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/shared/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/shared/dist",
        "main": "packages/shared/src/index.ts",
        "tsConfig": "packages/shared/tsconfig.lib.json",
        "assets": ["packages/shared/src/assets"],
        "stripLeadingPaths": true,
        "generatePackageJson": false
      },
      "configurations": {
        "development": {
          "sourceMap": true,
          "optimization": false,
          "swcrc": "packages/shared/.swcrc"
        },
        "production": {
          "sourceMap": false,
          "optimization": true,
          "swcrc": "packages/shared/.prod.swcrc"
        }
      }
    }
  }
}
