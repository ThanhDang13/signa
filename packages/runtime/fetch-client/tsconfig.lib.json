{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "*": [
        "./src/*"
      ]
    },
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "resolveJsonModule": false,
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../dsl/http-client/tsconfig.lib.json"
    }
  ]
}
