{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": false,
      "dynamicImport": true
    },
    "baseUrl": "./src",
    "paths": { "src/*": ["*"] },
    "transform": {},
    "target": "es2022",
    "keepClassNames": true,
    "minify": {
      "compress": true,
      "mangle": true
    }
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": false,
  "minify": true
}
