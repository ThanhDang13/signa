{
  "name": "@signa/nest-jwt",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nest/jwt/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/nest/jwt/dist",
        "main": "packages/nest/jwt/src/index.ts",
        "tsConfig": "packages/nest/jwt/tsconfig.lib.json",
        "assets": ["packages/nest/jwt/src/assets"],
        "stripLeadingPaths": true
      },
      "configurations": {
        "development": {
          "sourceMap": true,
          "optimization": false,
          "swcrc": "packages/nest/jwt/.swcrc"
        },
        "production": {
          "sourceMap": false,
          "optimization": true,
          "swcrc": "packages/nest/jwt/.prod.swcrc"
        }
      }
    }
  }
}
