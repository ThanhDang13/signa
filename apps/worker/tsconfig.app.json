{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "declarationDir": "dist",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@signa/worker/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["eslint.config.js", "eslint.config.cjs", "eslint.config.mjs"],
  "references": [
    {
      "path": "../../packages/dsl/queue-contract/tsconfig.lib.json"
    },
    {
      "path": "../../packages/nest/error/tsconfig.lib.json"
    },
    {
      "path": "../../packages/shared/tsconfig.lib.json"
    },
    {
      "path": "../../packages/runtime/error/tsconfig.lib.json"
    },
    {
      "path": "../../packages/nest/s3/tsconfig.lib.json"
    },
    {
      "path": "../../packages/nest/queue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/nest/config/tsconfig.lib.json"
    },
    {
      "path": "../../packages/contracts/queue/tsconfig.lib.json"
    }
  ]
}
